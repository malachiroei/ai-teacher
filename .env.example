# Required for live chat. Keys typically start with AIza or AQ.
GEMINI_API_KEY=
# Optional alias:
# GOOGLE_GENERATIVE_AI_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required on the host for /api/notifications/send-reminders (cron).
# Subscribe + test-push work with the logged-in user session alone.

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@buddyai.app
CRON_SECRET=
